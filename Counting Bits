class Solution {
    static public int[] countBits(int n) {
        int i;
        //int[] s = new int[100];
        int[] f = new int[n + 1];;
        f[0] = 0;
        for(i =1;i<=n;i++){
            int[] s = new int[100];
            int temp = i;
            int index =0;
            while(temp > 0){
                int r = temp%2;
                s[index] = r;
                temp = temp/2;
                index++;
            }
            int count =0;
            if(s.length > 0){
                for(int j =0;j<index;j++){
                    if(s[j] == 1){
                        count++;
                    }
                }
                f[i] = count;
            }
        }
        return f;
    }
    public static void main(String args[]){
        System.out.println(countBits(2));
    }
}
